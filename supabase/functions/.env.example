# Secrets for the Gmail Edge Functions (gmail-connection, gmail-oauth-callback).
# Copy to supabase/functions/.env (git-ignored), fill in, then:
#   npx supabase secrets set --env-file supabase/functions/.env --project-ref <ref>
# Never put any of these in the browser app or in git.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to hosted functions
# automatically; don't set them here (names starting SUPABASE_ are reserved).

# Google Cloud → Google Auth Platform → Clients → your Web client
GOOGLE_OAUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-replace-me

# Exactly the authorised redirect URI registered on that client
GMAIL_OAUTH_REDIRECT_URI=https://your-project-ref.supabase.co/functions/v1/gmail-oauth-callback

# 32 random bytes, base64: openssl rand -base64 32
# Losing or changing it makes stored Gmail access unreadable (people reconnect).
GMAIL_TOKEN_ENCRYPTION_KEY=

# Where Friday runs (https). People land on <this>/connections/gmail after Google.
FRIDAY_APP_URL=https://your-friday-app.example

# Optional: more browser origins allowed to call gmail-connection, comma-separated
# (e.g. http://localhost:5173 while developing against this project).
FRIDAY_ALLOWED_ORIGINS=

# Optional: alert senders to search, comma-separated domains or exact addresses.
# Empty = Friday's defaults (major Indian banks, cards and wallets).
GMAIL_ALERT_SENDERS=
